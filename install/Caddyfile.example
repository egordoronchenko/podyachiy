# Образец настройки прокси Caddy для HTTPS. Скопируйте как «Caddyfile» (без расширения)
# в рабочую папку сервиса, рядом с compose.yml, и оставьте ОДИН из трёх вариантов.
# Как включить прокси — install/README.md, раздел «Включить HTTPS».
#
# Везде замените podyachiy.example.ru на имя, по которому люди открывают сервис.
# Это имя должно быть заведено в DNS организации и указывать на адрес сервера.
# «podyachiy:8080» менять не нужно: это сервис внутри Docker, а не адрес в сети.
#
# Проверка файла до запуска:
#   docker run --rm -v "./Caddyfile:/etc/caddy/Caddyfile:ro" -v "./certs:/certs:ro" caddy:2 caddy validate --config /etc/caddy/Caddyfile

# ---------------------------------------------------------------------------------------
# Вариант 1 (основной). Сертификат выдал центр сертификации организации.
# Нужны два файла в папке certs рядом с compose.yml:
#   certs/podyachiy.crt — сертификат сервера и следом за ним промежуточные сертификаты
#                         (формат PEM, текст «-----BEGIN CERTIFICATE-----»);
#   certs/podyachiy.key — закрытый ключ к нему (PEM, без пароля).
# Корневому сертификату организации компьютеры сотрудников обычно уже доверяют.
# ---------------------------------------------------------------------------------------
podyachiy.example.ru {
	tls /certs/podyachiy.crt /certs/podyachiy.key
	reverse_proxy podyachiy:8080
}

# ---------------------------------------------------------------------------------------
# Вариант 2. Сертификата нет: Caddy выпускает его сам, своим внутренним центром.
# Соединение шифруется, но браузеры будут предупреждать «сертификат не доверенный»,
# пока корневой сертификат Caddy не установлен на компьютеры людей как доверенный.
# Он появится после первого запуска: caddy/data/caddy/pki/authorities/local/root.crt
# Вместо имени можно указать адрес сервера: https://192.0.2.10
# ---------------------------------------------------------------------------------------
# podyachiy.example.ru {
# 	tls internal
# 	reverse_proxy podyachiy:8080
# }

# ---------------------------------------------------------------------------------------
# Вариант 3. Публичное имя и бесплатный сертификат Let's Encrypt: Caddy получает
# и продлевает его сам. Условия: имя есть в публичном DNS и указывает на этот сервер,
# порты 80 и 443 сервера доступны из интернета. То есть сервис становится виден из
# интернета — решайте это со службой безопасности: сервис рассчитан на внутреннюю сеть.
# Блок с почтой — первым в файле: на этот адрес центр сертификации пишет о проблемах.
# ---------------------------------------------------------------------------------------
# {
# 	email it@example.ru
# }
#
# podyachiy.example.ru {
# 	reverse_proxy podyachiy:8080
# }
