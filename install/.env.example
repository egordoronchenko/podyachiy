# Образец настроек. Скопируйте его под именем .env в папку, где лежит compose.yml, и заполните.
# Обязательны две строки: OPENAI_API_KEY и (в корпоративном режиме) ADMIN_PASSWORD.
# Описание каждой строки таблицей — install/README.md, раздел «Настройки .env».
# Ставите для себя (MODE=personal) — какие строки поменять, сказано в install/personal.md.
# Файл .env не коммитить — он уже в .gitignore.

# ---------- образ и проект Docker ----------
# Версия образа. latest — последний выпуск; номер (например 1.0.0) закрепляет версию:
# обновление тогда происходит, только когда вы сами смените номер.
IMAGE_TAG=latest
# Имя проекта Docker Compose. В compose.yml оно задано — podyachiy; своё имя нужно только
# второй установке на той же машине, иначе она пересоздаст контейнер первой.
#COMPOSE_PROJECT_NAME=podyachiy-test
# Только при сборке образа из исходников (корневой compose.yml): дата сборки и коммит для
# раздела «О сервисе». Готовому образу не нужны.
#BUILD_DATE=
#GIT_COMMIT=

# ---------- папки на хосте ----------
# По умолчанию всё лежит рядом с compose.yml: inbox, outbox, state и prompts.
# Пути можно заменить своими; на Windows — прямыми слешами: D:/Записи.
#
# Входная папка: сюда кладут записи, по подпапкам — руками или кнопкой на странице.
HOST_INBOX=./inbox

# Выходная папка: расшифровки, протоколы, карты, журнал и лог.
# Не делай её вложенной в HOST_INBOX — сервис такие файлы пропустит, но путаницы будет больше.
# Без неё сервис не запустится: протоколы, за которые заплачено, легли бы внутрь контейнера.
HOST_OUTBOX=./outbox

# Папка состояния: база сервиса podyachiy.db — пользователи (пароли — хешами), права, ключи
# доступа, словари, расходы, журнал обработки — и ключ подписи входов. Только локальный диск
# сервера: на сетевой папке база ненадёжна. По сети её не раздают. Без неё сервис не запустится;
# удалите её — пропадёт всё перечисленное, а записи пойдут в обработку заново, за деньги.
HOST_STATE=./state

# Папка для резервных копий: сюда кладут архивы копия по расписанию со страницы «Обработка» и
# команда копии (install/README.md, раздел 12).
# Лучше — другой диск или сетевая папка: копия на том же диске не спасёт, когда диск откажет.
HOST_BACKUP=./backup

# Шаблоны протоколов и словарь терминов. При первом запуске сервис сам кладёт
# сюда исходные файлы; дальше их правят на хосте, правка действует сразу.
HOST_PROMPTS=./prompts

# ---------- поставщики и модели ----------
# Сервис ходит к моделям через шлюз с OpenAI-совместимым API. Проверены два:
#   RouterAI   — https://routerai.ru/api/v1   — российский, оплата в рублях со счёта
#                организации; стоимость в отчётах — в рублях;
#   OpenRouter — https://openrouter.ai/api/v1 — зарубежный, оплата в долларах; стоимость
#                в отчётах — в долларах.
# Модели у них называются одинаково, цены разные — сравните карточки моделей.
#
# Достаточно одного поставщика — основного. Рекомендуемая схема для России:
#   OPENAI_BASE_URL=https://routerai.ru/api/v1        основной — RouterAI
#   OPENAI_API_KEY=<ключ RouterAI>
#   BACKUP_BASE_URL=https://openrouter.ai/api/v1      запасной — OpenRouter
#   BACKUP_API_KEY=<ключ OpenRouter>
#
# Основной поставщик: ключ и адрес — и для распознавания речи, и для текстовых моделей
# (текстовым можно задать свой адрес — SUMMARY_BASE_URL ниже).
# Ключ в образ не попадает, в логи не пишется, на страницах не показывается.
# Принят ли ключ, сервис проверяет бесплатным запросом при запуске (строка в журнале работы)
# и по кнопке «Проверить ключ» в разделе «Управление → Обработка».
# Сервис понимает и имя OPENROUTER_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Запасной поставщик — необязательно. Ему уходит вызов, на который основной не ответил:
# нет связи, таймаут, ошибка сервера или «слишком много запросов» после всех повторов,
# либо отказ по ключу или деньгам (401, 402, 403) — сразу. После этого пять минут запросы
# идут сразу запасному, потом основной пробуется снова. Расход записывается в валюте того,
# кто ответил: в отчёте «Расходы» рубли и доллары стоят отдельно и не пересчитываются.
# В журнале работы переход виден строкой «основной поставщик … не ответил … — запрос ушёл
# запасному …», а при отказе по ключу или балансу — с пометкой ВНИМАНИЕ.
# Пусто — запасного нет.
BACKUP_BASE_URL=
BACKUP_API_KEY=

# Распознавание речи с разделением говорящих — один вызов на всю запись.
# Модель — только из списка ниже (таблица в app/speech.py); с другой сервис
# не запустится и назовёт причину. Пустое значение — elevenlabs/scribe-v2.
# Цены — из карточек моделей OpenRouter, в долларах; у RouterAI они в рублях и свои.
# Это значение по умолчанию: администратор может выбрать другую модель на странице
# «Управление → Обработка» — без перезапуска; выбор хранится в папке состояния.
#   elevenlabs/scribe-v2       — 0,11 $/час (скидка 50 %, без неё 0,22); говорящих
#                                делит надёжно, термины распознаёт лучше других
#   deepgram/nova-3            — 0,26 $/час; говорящих делит надёжно, но чаще
#                                ошибается в терминах и английских словах
#   microsoft/mai-transcribe-2 — 0,10 $/час; единственная получает словарь
#                                prompts/glossary.txt подсказкой; редко говорящих
#                                людей сливает с соседями
# Смена модели действует на новые записи. Готовые расшифровки остаются как есть:
# пересборка протокола берёт их, какой бы моделью они ни были сделаны. Распознать
# старую запись другой моделью — ручной запуск с галкой «перезаписать» (платно,
# ручные подписи говорящих сбрасываются).
SPEECH_MODEL=elevenlabs/scribe-v2

# Текстовая модель: разбор записи и протокол по готовой расшифровке.
# Стоит копейки против распознавания. Подходят, например, deepseek/deepseek-v4.1-flash
# (быстрая) и z-ai/glm-5.3-flash (то же качество, но заметно медленнее).
SUMMARY_MODEL=deepseek/deepseek-v4.1-flash

# Кто выписывает поручения совещания перед протоколом. Модели читают расшифровку
# независимо и находят разное: одна пропускает заметно больше, чем две вместе.
# Протокол получает все списки. Через запятую, адрес и ключ — те же, что у SUMMARY_MODEL:
# все перечисленные модели должны быть доступны по адресу текстовых этапов.
ACTIONS_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-6-luna

# Свой адрес и ключ для текстовых этапов (разбор записи, поручения, протокол).
# Пусто — те же, что у речи: OPENAI_BASE_URL и OPENAI_API_KEY. Запасной поставщик
# текст со своим адресом не подхватывает: модели там называются по-своему.
SUMMARY_BASE_URL=
SUMMARY_API_KEY=

# Сколько секунд ждать ответ текстовой модели. Облачной хватает пятнадцати минут
# с тройным запасом; локальная пишет протокол дольше.
SUMMARY_TIMEOUT_SEC=900

# ---------- текст на локальной модели через LM Studio ----------
# Речь по-прежнему распознаёт облако (OPENAI_*), а разбор, поручения и протокол пишет
# модель на этой машине: расшифровка за её пределы не уходит и текст ничего не стоит.
# В LM Studio: загрузить модель, включить сервер (Developer → Start Server, порт 1234),
# длину контекста модели поставить около 40 000 — иначе длинная расшифровка обрежется.
# Чтобы включить, раскомментируйте блок и уберите одноимённые строки выше.
#
# Адрес LM Studio из контейнера; host.docker.internal — эта же машина.
#SUMMARY_BASE_URL=http://host.docker.internal:1234/v1
# Ключ LM Studio не проверяет, но строка нужна: без неё сюда уйдёт ключ OPENAI_API_KEY.
#SUMMARY_API_KEY=lm-studio
# Имя модели — как в списке LM Studio (или http://localhost:1234/v1/models).
#SUMMARY_MODEL=qwen3-14b
# Поручения выписывает она же: второй модели по локальному адресу нет.
#ACTIONS_MODELS=qwen3-14b
# Локальная модель пишет протокол минутами — ждать до часа.
#SUMMARY_TIMEOUT_SEC=3600
# Правила PROVIDER_* на локальный адрес не действуют: поле provider уходит только
# в OpenRouter. SUMMARY_REASONING оставьте пустым.

# Сколько модели рассуждать перед ответом: low, medium или high.
# Пусто — решает сама.
SUMMARY_REASONING=

# Кому из поставщиков текстовой модели OpenRouter отдаёт запрос. У одной модели их
# десятки, и без правил он выбирает по цене — а скорость у них различается в 14 раз.
#
# Порог скорости, токенов в секунду. Кто медленнее — в конец очереди: к ним запрос
# уйдёт, только если быстрые недоступны. Среди прошедших выбор по цене. 0 — без порога.
PROVIDER_MIN_THROUGHPUT=150
# Потолок цены, $ за миллион токенов ответа. Поставщики дороже не используются.
# 0 — без потолка. Модель дороже потолка перестанет отвечать совсем — поднимите его.
PROVIDER_MAX_PRICE=1.5
# Допустимые степени сжатия весов модели. Сильно сжатые (fp4, int4, int8) отвечают
# хуже, поэтому в списке их нет. Пусто — любые.
PROVIDER_QUANTIZATIONS=fp8,fp16,bf16,fp32,unknown

# Лимит ответа для протокола. Пусто — не ограничивать: параметр в запрос
# не уходит, предел определяет сам провайдер по модели. Так и рекомендуется.
# У рассуждающих моделей (и glm, и deepseek в их числе) лимит покрывает рассуждения
# И ответ вместе: любое своё число здесь — способ однажды упереться в него
# и получить пустой протокол. Заполняйте, только если провайдер сам режет ответ.
SUMMARY_MAX_TOKENS=

# Язык записей: код ISO-639-1 (ru, en, de, ...) или auto.
LANGUAGE=ru

# В чём считает стоимость поставщик, адрес которого сервису незнаком: код валюты (USD,
# RUB). У RouterAI и OpenRouter валюта известна по адресу, на них настройка не действует.
COST_CURRENCY=USD

# ---------- обход папки ----------
# Как часто опрашивать входную папку, секунды.
SCAN_INTERVAL_SEC=10

# Сколько секунд размер и время изменения файла должны не меняться, чтобы считать
# его дописанным. Тридцать секунд взяты с запасом: запись совещания весит полтора-два
# гигабайта, по гигабитной сети копируется секунд двадцать-тридцать, а короткие
# заминки при копировании по Wi-Fi не должны считаться завершением.
STABLE_SEC=30

# ---------- обработка ----------
# Сколько записей обрабатывать одновременно. Почти вся обработка — ожидание ответа
# провайдера, своя машина при этом простаивает, поэтому три записи идут почти так же
# быстро, как одна. Денег это не меняет: платим за минуты звука и токены, а не за скорость.
# 1 — строго по одной. Больше пяти ставить незачем: упрётесь в пределы провайдера
# (ответ 429 сервис пережидает сам, но время на это уходит). ffmpeg — не больше двух сразу.
WORKERS=3

# Дописывать в конец нового протокола раздел «Поручения прошлого совещания» — незакрытые
# поручения предыдущей записи той же папки, если папка отмечена как серия совещаний (кнопка
# «Серия» в шапке папки; в корне раздела нет никогда). Раздел собирает сам сервис, без вызова
# модели, шаблоны не меняются. Готовые протоколы не переписываются: раздел появится при
# следующей обработке или пересборке. 0 — выключить для всех папок.
PREV_TASKS=1

# ---------- загрузка через страницу ----------
# Предел размера одной записи, гигабайты. Файл уходит частями и после обрыва связи
# догружается с принятого места; брошенная недогрузка хранится неделю.
UPLOAD_MAX_GB=4

# ---------- режим ----------
# corporate — для компании: вход обязателен, у каждого пользователя свои папки, доступ
#             раздаёт администратор. Нужен ADMIN_PASSWORD.
# personal  — для одного человека на своём компьютере: входа нет, всё открыто, вы и есть
#             администратор. ADMIN_PASSWORD не нужен. В сеть такой сервис открывать нельзя
#             (BIND оставьте 127.0.0.1): он отдаст всё любому. Коротко — install/personal.md.
# Папка состояния (HOST_STATE) нужна в обоих режимах: в ней база сервиса.
MODE=corporate

# ---------- администрирование ----------
# Пароль администратора сервиса: с ним входят под логином admin. В корпоративном режиме
# обязателен: пока пользователей нет, войти может только администратор. В личном режиме
# (MODE=personal) входа нет, и пароль не нужен.
# Значение задаётся только в .env: в репозитории пароля быть не должно.
ADMIN_PASSWORD=

# ---------- почта: заявки на доступ, письма о готовности, протокол на почту ----------
# Без почты пользователей заводит только администратор. С почтой на странице входа появляются
# ссылки «Запросить доступ» и «Забыл пароль»: человеку уходит письмо с логином и одноразовой
# ссылкой «задать пароль» на 48 часов — сам пароль письмом не шлётся. Подробно —
# install/README.md, раздел «Почта и заявки на доступ». Почта включается, когда заданы SMTP_HOST, SMTP_FROM
# (или SMTP_USER) и PUBLIC_URL. Проверка — кнопка «Отправить пробное письмо» в разделе «Пользователи».
#
# Почтовый сервер организации. Пусто — почта выключена.
#SMTP_HOST=mail.example.ru
# Порт. Пусто — обычный для выбранной защиты: 587 (starttls), 465 (ssl), 25 (none).
#SMTP_PORT=
# Защита соединения: none | starttls | ssl. С none логин и пароль из SMTP_USER и SMTP_PASSWORD
# идут до почтового сервера открытым текстом — сервис предупредит об этом при запуске.
#SMTP_SECURITY=starttls
# Сертификат почтового сервера выдан внутренним центром сертификации организации — путь внутри
# контейнера к корневому сертификату этого центра (PEM). Проще всего положить файл в папку
# состояния (HOST_STATE): в контейнере она видна как /data/state. Пусто — сертификат сверяется
# с центрами, которым доверяет система. SMTP_HOST должен совпадать с именем в сертификате.
#SMTP_CA_FILE=/data/state/smtp-ca.pem
# Логин и пароль на почтовом сервере. Пусто — без входа (сервер принимает почту от своих и так).
#SMTP_USER=podyachiy@example.ru
#SMTP_PASSWORD=
# От чьего имени уходят письма: адрес или имя с адресом в угловых скобках. По умолчанию — SMTP_USER.
#SMTP_FROM=Подьячий <podyachiy@example.ru>
# Адрес, по которому сервис открывают люди: он стоит в ссылках из писем и в навыке для
# ИИ-клиентов (Cursor, Claude Code, Codex — раздел справки «Интеграция с ИИ»). Без него почта
# выключена, а в навык подставляется адрес, по которому пришёл запрос, — у того, кто открыл
# сервис как localhost, навык получится с localhost. Задайте его, даже если почта не нужна.
# За прокси, который меняет заголовок Host, — обязательно: по этому адресу сервис узнаёт свои
# страницы, иначе действия на странице получат отказ 403 («запрос со страницы другого сайта»).
#PUBLIC_URL=http://192.0.2.10:8081
# Кому писать о новых заявках на доступ; несколько адресов — через запятую.
#ADMIN_EMAIL=it@example.ru
# С почтой сервис ещё и пишет человеку, когда его запись готова, и раз в день напоминает о сроках
# его поручений (и то и другое отключается в меню учётной записи), а хозяин папки может отправить
# протокол на почту из открытой записи. Протокол — это содержимое совещания, и уйти он может на
# любой адрес. MAIL_DOMAINS — почтовые домены организации через запятую: протокол уходит и заявка
# на доступ принимается только с адресами этих доменов, адреса вне списка сервис не примет. Пусто —
# любые адреса, и с включённой почтой сервис об этом предупреждает. Задайте домен почты своей
# организации.
#MAIL_DOMAINS=example.ru
# По HTTP ссылка из письма и новый пароль идут по сети открыто — как и пароль при входе.

# ---------- webhook «запись готова» ----------
# Сервис сам сообщает внешней системе (1С, трекеру задач, своему скрипту), что запись готова или
# обработать её не удалось: POST с JSON на адрес WEBHOOK_URL (несколько — через запятую). Тело
# подписано: заголовок X-Podyachiy-Signature — HMAC-SHA256 секретом WEBHOOK_SECRET, получатель
# сверяет подпись. Секрет — длинная случайная строка, та же, что у получателя; без него webhook
# выключен. Не принял (не 2xx, нет ответа за 10 с) — повтор через 1, 5, 30 мин, 2 ч и 12 ч.
# Формат тела и пример проверки подписи — раздел «API» сервиса (/api), «Webhook».
#WEBHOOK_URL=https://erp.example.ru/podyachiy/hook
#WEBHOOK_SECRET=

# ---------- вход через домен (Active Directory), только корпоративный режим ----------
# Люди входят логином и паролем домена — теми же, что на рабочем компьютере; сервис проверяет
# их у контроллера домена по LDAP и сам заводит человека при первом входе. Пароль в сервисе не
# хранится. Работает только по HTTPS (доменный пароль нельзя гонять по сети открыто) и только
# с шифрованием до контроллера. admin и локальные учётные записи входят как раньше — это
# запасной вход, если домен недоступен. Подробно, по шагам и с разбором отказов —
# install/README.md, раздел «Вход через домен». Проверка — кнопка «Проверить подключение»
# в разделе «Пользователи».
#
# Контроллеры домена через запятую, по порядку: не ответил первый — сервис идёт к следующему.
# Полные имена, как в сертификатах контроллеров. Пусто — входа через домен нет.
#LDAP_URL=ldaps://dc1.corp.local:636,ldaps://dc2.corp.local:636
# Где искать людей и группы.
#LDAP_BASE_DN=DC=corp,DC=local
# Служебная учётная запись только на чтение: ею сервис ищет людей и читает их группы.
# Пароль хранится только здесь: на странице и в журналах его нет.
#LDAP_BIND_DN=CN=svc-podyachiy,OU=Service,DC=corp,DC=local
#LDAP_BIND_PASSWORD=
# Группа доступа (DN или имя): входить могут только её члены, считая вложенные группы.
# Пусто — любой действующий пользователь домена из базы поиска.
#LDAP_ACCESS_GROUP=Podyachiy-Users
# Группа администраторов сервиса (DN или имя): вошёл в группу — стал администратором сервиса,
# исключён — роль снимается. Пусто — роль ставит администратор сервиса вручную.
#LDAP_ADMIN_GROUP=Podyachiy-Admins
# Короткое имя домена — подсказка на странице входа.
#LDAP_DOMAIN=CORP
# Корневой сертификат центра сертификации организации (PEM), которым подписан сертификат
# контроллера. Проще положить его в папку состояния под именем ldap-ca.pem — сервис найдёт сам.
# Здесь — путь внутри контейнера, если файл лежит в другом месте.
#LDAP_CA_FILE=
# 1 — адрес ldap://…:389 с шифрованием StartTLS вместо ldaps://…:636.
#LDAP_STARTTLS=0
# Фильтр учётных записей людей. По умолчанию — люди Active Directory.
#LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
# Как часто (минуты) сервис сверяет вошедшего с доменом: не отключён ли, остался ли в группе.
#LDAP_RECHECK_MIN=15
# За прокси (HTTPS) сервису нужно знать его адрес — иначе он не узнает, что человек пришёл по
# HTTPS, и вход через домен не примет. Как закрепить адрес прокси — install/README.md, 10а, шаг 1.
#FORWARDED_ALLOW_IPS=172.31.250.2
#
# НЕБЕЗОПАСНО, только для стенда. Сервис громко пишет об этом в лог и на странице.
# 0 — не проверять сертификат контроллера: подменённый контроллер получит пароли людей.
#LDAP_TLS_VERIFY=1
# 1 — принимать вход через домен по HTTP и ходить к контроллеру без шифрования.
#LDAP_ALLOW_HTTP=0

# Часовой пояс контейнера: время в логах и журнале.
TZ=Europe/Moscow

# Порт страницы на хосте.
PORT=8081

# На каком адресе машины слушать. 127.0.0.1 — страница открывается только с этого
# компьютера. 0.0.0.0 — из локальной сети, по адресу вида http://192.0.2.10:8081.
# С включённым HTTPS (прокси Caddy) — снова 127.0.0.1: люди ходят через прокси.
BIND=127.0.0.1

# ---------- HTTPS (прокси Caddy) ----------
# Действуют, только если в compose.yml включён блок caddy — см. install/README.md,
# раздел «Включить HTTPS». Порты прокси на сервере и адрес, на котором он слушает.
#HTTPS_PORT=443
#HTTP_PORT=80
#HTTPS_BIND=0.0.0.0

# ---------- пути внутри контейнера ----------
# Менять не нужно: так они смонтированы в compose.yml.
INBOX_DIR=/data/inbox
OUTBOX_DIR=/data/outbox
STATE_DIR=/data/state
BACKUP_DIR=/data/backup
PROMPTS_DIR=/app/prompts
